  <!-- ======================================================================= -->
  <!-- LÓGICA COMPLETA E BLINDADA DA APLICAÇÃO                                 -->
  <!-- ======================================================================= -->
  <script>
    (function () {
      'use strict';

      // =====================================================================
      // 1. STORAGE SEGURO (PROTEÇÃO CONTRA SANDBOX / IFRAME SECURITYERROR)
      // =====================================================================
      const memoryStorage = {};
      const SafeStorage = {
        getItem(key) {
          try {
            return window.localStorage.getItem(key);
          } catch (e) {
            return Object.prototype.hasOwnProperty.call(memoryStorage, key) ? memoryStorage[key] : null;
          }
        },
        setItem(key, value) {
          memoryStorage[key] = String(value);
          try {
            window.localStorage.setItem(key, String(value));
          } catch (e) {
            // Silenciosamente usa memória caso localStorage esteja bloqueado no iframe
          }
        },
        removeItem(key) {
          delete memoryStorage[key];
          try {
            window.localStorage.removeItem(key);
          } catch (e) {
            // Ignora erro de sandbox
          }
        }
      };

      // =====================================================================
      // 2. CATÁLOGO DE CRIPTOS & PREÇOS INICIAIS DE FALLBACK IMEDIATO
      // =====================================================================
      const STORAGE_KEY = 'rg_crypto_dca_retirement_v3';

      const SUPPORTED_CRYPTOS = [
        { symbol: 'POL',  name: 'Polygon (POL)', binancePair: 'POLUSDT',  fallbackPair: 'MATICUSDT', coingeckoId: 'polygon-ecosystem-token', color: '#8b5cf6', fallbackUSD: 0.42 },
        { symbol: 'BNB',  name: 'BNB',           binancePair: 'BNBUSDT',  fallbackPair: null,        coingeckoId: 'binancecoin',             color: '#f59e0b', fallbackUSD: 645.00 },

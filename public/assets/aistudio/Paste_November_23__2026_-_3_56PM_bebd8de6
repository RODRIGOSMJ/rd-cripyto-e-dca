      window.updateMonthlyRecord = function (goalId, monthIndex, field, rawValue) {
        const goal = appState.goals.find(g => g.id === goalId);
        if (!goal || !goal.monthlyRecords[monthIndex]) return;

        const val = parseFloat(rawValue);
        const cleanVal = isNaN(val) || val < 0 ? 0 : val;

        if (field === 'boughtQty') {
          goal.monthlyRecords[monthIndex].boughtQty = cleanVal;
          if (cleanVal > 0 && goal.monthlyRecords[monthIndex].pricePaidUSD === 0) {
            goal.monthlyRecords[monthIndex].pricePaidUSD = Number(appState.pricesUSD[goal.symbol]) || 0;
            goal.monthlyRecords[monthIndex].fxRateBRL = getEffectiveUsdtBrlRate();
          }
        } else if (field === 'pricePaid') {
          goal.monthlyRecords[monthIndex].pricePaidUSD = convertToUSD(cleanVal);
        } else if (field === 'fxRateBRL') {
          goal.monthlyRecords[monthIndex].fxRateBRL = cleanVal > 0 ? cleanVal : getEffectiveUsdtBrlRate();
        }

        saveState();
        renderAll();
      };

      window.fillMonthTargetQty = function (goalId, monthIndex, plannedQty) {
        const goal = appState.goals.find(g => g.id === goalId);
        if (!goal || !goal.monthlyRecords[monthIndex]) return;

        goal.monthlyRecords[monthIndex].boughtQty = Number(Number(plannedQty).toFixed(4));
        if (goal.monthlyRecords[monthIndex].pricePaidUSD === 0) {
          goal.monthlyRecords[monthIndex].pricePaidUSD = Number(appState.pricesUSD[goal.symbol]) || 0;
          goal.monthlyRecords[monthIndex].fxRateBRL = getEffectiveUsdtBrlRate();
        }
        saveState();
        renderAll();
      };

      window.fillMonthLivePrice = function (goalId, monthIndex) {
        const goal = appState.goals.find(g => g.id === goalId);
        if (!goal || !goal.monthlyRecords[monthIndex]) return;

        const liveUSD = Number(appState.pricesUSD[goal.symbol]) || 0;
        goal.monthlyRecords[monthIndex].pricePaidUSD = liveUSD;
        goal.monthlyRecords[monthIndex].fxRateBRL = getEffectiveUsdtBrlRate();
        saveState();
        renderAll();
        showToast(`Mês ${monthIndex + 1} preenchido com cotação atual (${formatUSDT(liveUSD)})!`, 'success');
      };

      window.autoFillNextEmptyMonth = function (goalId) {
        const goal = appState.goals.find(g => g.id === goalId);
        if (!goal) return;

        const emptyIdx = goal.monthlyRecords.findIndex(r => !r.boughtQty || r.boughtQty <= 0);
        if (emptyIdx === -1) {
          showToast('Todos os meses já possuem compras registradas!', 'info');
          return;
        }

        const m = calculateGoalMetrics(goal);
        goal.monthlyRecords[emptyIdx].boughtQty = Number(m.baseMonthlyTargetQty.toFixed(4));
        goal.monthlyRecords[emptyIdx].pricePaidUSD = m.currentPriceUSD;
        goal.monthlyRecords[emptyIdx].fxRateBRL = getEffectiveUsdtBrlRate();

        saveState();
        renderAll();
        showToast(`Mês ${emptyIdx + 1} registrado (${formatCryptoQty(m.baseMonthlyTargetQty, goal.symbol)})!`, 'success');
      };


      function updateModalLivePreview() {
        const previewEl = document.getElementById('modal-live-preview');
        if (!previewEl) return;

        const initBal = Math.max(0, parseFloat(document.getElementById('form-initial-balance').value) || 0);
        const target = Math.max(0, parseFloat(document.getElementById('form-target-amount').value) || 0);
        const months = Math.max(1, parseInt(document.getElementById('form-months').value, 10) || 12);
        const retPriceDisplay = Math.max(0, parseFloat(document.getElementById('form-retirement-price').value) || 0);

        const sel = document.getElementById('form-asset-select').value;
        const sym = sel === 'CUSTOM'
          ? (document.getElementById('form-custom-symbol').value.trim().toUpperCase() || 'CRIPTO')
          : sel;

        const toBuy = Math.max(0, target - initBal);
        const perMonth = toBuy / months;
        const liveUSD = sel === 'CUSTOM'
          ? (parseFloat(document.getElementById('form-custom-price').value) || Number(appState.pricesUSD[sym]) || 0)
          : (Number(appState.pricesUSD[sym]) || 0);

        const monthlyCostUSD = perMonth * liveUSD;
        const retTotalUSD = target * convertToUSD(retPriceDisplay);

        previewEl.innerHTML = `
          <div class="font-bold text-emerald-300">Resumo Automático do Plano:</div>
          <div>• Você precisa comprar <strong>${formatCryptoQty(toBuy, sym)}</strong> em <strong>${months} meses</strong> = <strong>${formatCryptoQty(perMonth, sym)}/mês</strong>.</div>
          ${liveUSD > 0 ? `<div>• Custo mensal estimado hoje: <strong>${formatMoney(monthlyCostUSD, 2)}/mês</strong>.</div>` : ''}
          <div>• Patrimônio projetado na aposentadoria: <strong>${formatMoney(retTotalUSD, 2)}</strong>.</div>
        `;
      }

      ['form-initial-balance', 'form-target-amount', 'form-months', 'form-retirement-price', 'form-custom-symbol', 'form-custom-price'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('input', updateModalLivePreview);
      });

      window.saveGoalForm = function (e) {
        e.preventDefault();

        const existingId = document.getElementById('form-goal-id').value;
        const selectedAsset = document.getElementById('form-asset-select').value;

        let symbol, name, binancePair, fallbackPair, coingeckoId, color;

        if (selectedAsset === 'CUSTOM') {
          symbol = document.getElementById('form-custom-symbol').value.trim().toUpperCase();
          name = document.getElementById('form-custom-name').value.trim() || symbol;
          const customPrice = parseFloat(document.getElementById('form-custom-price').value);
          if (!symbol) {
            showToast('Informe o ticker da criptomoeda.', 'error');
            return;
          }
          if (!isNaN(customPrice) && customPrice > 0) {
            appState.pricesUSD[symbol] = customPrice;
          } else if (!appState.pricesUSD[symbol]) {
            appState.pricesUSD[symbol] = 1.00;
          }
          binancePair = `${symbol}USDT`;
          fallbackPair = null;
          coingeckoId = symbol.toLowerCase();
          const palette = ['#ec4899', '#14b8a6', '#6366f1', '#f43f5e', '#84cc16'];
          color = palette[appState.goals.length % palette.length];
        } else {
          const meta = SUPPORTED_CRYPTOS.find(c => c.symbol === selectedAsset);
          symbol = meta.symbol;
          name = meta.name;
          binancePair = meta.binancePair;
          fallbackPair = meta.fallbackPair;
          coingeckoId = meta.coingeckoId;
          color = meta.color;
        }

        const initialBalance = Math.max(0, parseFloat(document.getElementById('form-initial-balance').value) || 0);
        const targetAmount = Math.max(0.000001, parseFloat(document.getElementById('form-target-amount').value) || 100);
        const monthsCount = Math.min(120, Math.max(1, parseInt(document.getElementById('form-months').value, 10) || 12));
        const retirementPriceDisplay = Math.max(0, parseFloat(document.getElementById('form-retirement-price').value) || 0);
        const retirementTargetPriceUSD = convertToUSD(retirementPriceDisplay);

        if (existingId) {
          const goal = appState.goals.find(g => g.id === existingId);
          if (goal) {
            goal.symbol = symbol;
            goal.name = name;
            goal.binancePair = binancePair;
            goal.fallbackPair = fallbackPair;
            goal.coingeckoId = coingeckoId;
            goal.color = color;
            goal.initialBalance = initialBalance;
            goal.targetAmount = targetAmount;
            goal.retirementTargetPriceUSD = retirementTargetPriceUSD;

            const updatedRecs = [];
            for (let i = 0; i < monthsCount; i++) {
              if (goal.monthlyRecords[i]) {
                updatedRecs.push(goal.monthlyRecords[i]);
              } else {
                updatedRecs.push({
                  month: i + 1,
                  label: getFutureMonthLabel(i),
                  boughtQty: 0,
                  pricePaidUSD: 0,
                  fxRateBRL: getEffectiveUsdtBrlRate()
                });
              }
            }
            goal.monthsCount = monthsCount;
            goal.monthlyRecords = updatedRecs;
            appState.selectedGoalId = goal.id;
          }
          showToast(`Meta de ${symbol} atualizada!`, 'success');
        } else {
          const newId = `${symbol}_${Date.now()}`;
          const monthlyRecords = Array.from({ length: monthsCount }, (_, i) => ({
            month: i + 1,
            label: getFutureMonthLabel(i),
            boughtQty: 0,
            pricePaidUSD: 0,
            fxRateBRL: getEffectiveUsdtBrlRate()
          }));

          appState.goals.push({
            id: newId,
            symbol,
            name,
            binancePair,
            fallbackPair,
            coingeckoId,
            color,
            initialBalance,
            targetAmount,
            monthsCount,
            retirementTargetPriceUSD,
            monthlyRecords
          });
          appState.selectedGoalId = newId;
          appState.mainTab = 'DCA';
          showToast(`Meta de ${symbol} adicionada!`, 'success');
        }

        saveState();
        window.closeGoalModal();
        renderAll();
      };


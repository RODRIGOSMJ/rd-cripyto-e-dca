      // =====================================================================
      // 5. FORMATAÇÃO & CONVERSÃO DE MOEDA (USDT / HÍBRIDO / BRL)
      // =====================================================================
      function getMultiplier() {
        return appState.currency === 'BRL' ? getEffectiveUsdtBrlRate() : 1;
      }

      function convertFromUSD(amountUSD) {
        const val = Number(amountUSD);
        if (isNaN(val)) return 0;
        return val * getMultiplier();
      }

      function convertToUSD(amountDisplay) {
        const val = Number(amountDisplay);
        const mult = getMultiplier();
        if (isNaN(val) || mult <= 0) return 0;
        return val / mult;
      }

      function formatUSDT(amountUSDT, forceDecimals = null) {
        const val = Number(amountUSDT) || 0;
        let decimals = 2;
        if (forceDecimals !== null) {
          decimals = forceDecimals;
        } else if (Math.abs(val) > 0 && Math.abs(val) < 1) {
          decimals = 4;
        } else if (Math.abs(val) >= 1 && Math.abs(val) < 10) {
          decimals = 3;
        }
        const formatted = new Intl.NumberFormat('en-US', {
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals
        }).format(val);
        return `$${formatted} USDT`;
      }

      function formatBRL(amountBRL, forceDecimals = null) {
        const val = Number(amountBRL) || 0;
        let decimals = 2;
        if (forceDecimals !== null) {
          decimals = forceDecimals;
        } else if (Math.abs(val) > 0 && Math.abs(val) < 1) {
          decimals = 4;
        } else if (Math.abs(val) >= 1 && Math.abs(val) < 10) {
          decimals = 3;
        }
        return new Intl.NumberFormat('pt-BR', {
          style: 'currency',
          currency: 'BRL',
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals
        }).format(val);
      }

      function formatMoney(amountUSD, forceDecimals = null) {
        const valUSD = Number(amountUSD) || 0;
        if (appState.currency === 'BRL') {
          return formatBRL(valUSD * getEffectiveUsdtBrlRate(), forceDecimals);
        }
        return formatUSDT(valUSD, forceDecimals);
      }

      function renderDualMoneyHTML(amountUSD, forceDecimals = null, customBrlVal = null, subClass = 'text-[11px] font-mono font-normal text-slate-400 mt-0.5') {
        const valUSD = Number(amountUSD) || 0;
        const valBRL = customBrlVal !== null ? Number(customBrlVal) : (valUSD * getEffectiveUsdtBrlRate());

        if (appState.currency === 'HYBRID') {
          return `<div>${formatUSDT(valUSD, forceDecimals)}</div><div class="${subClass}">≈ ${formatBRL(valBRL, forceDecimals)}</div>`;
        }
        if (appState.currency === 'BRL') {
          return formatBRL(valBRL, forceDecimals);
        }
        return formatUSDT(valUSD, forceDecimals);
      }

      function formatCryptoQty(qty, symbol = '') {
        const num = Number(qty) || 0;
        const decimals = num % 1 === 0 ? 0 : (Math.abs(num) < 10 ? 4 : 2);
        const formatted = new Intl.NumberFormat('pt-BR', {
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals
        }).format(num);
        return symbol ? `${formatted} ${symbol}` : formatted;
      }


      function renderGlobalKPIs() {
        let totalPortfolioUSD = 0;
        let totalInvestedUSD = 0;
        let totalInvestedBRL = 0;
        let totalRemainingUSD = 0;
        let totalDcaValueUSD = 0;
        let totalRetirementUSD = 0;
        let sumProgress = 0;

        for (const g of appState.goals) {
          const m = calculateGoalMetrics(g);
          totalPortfolioUSD += m.totalPositionValueUSD;
          totalInvestedUSD += m.totalInvestedUSD;
          totalInvestedBRL += m.totalInvestedHistoricalBRL;
          totalRemainingUSD += m.estimatedRemainingTotalCostUSD;
          totalDcaValueUSD += m.dcaCurrentValueUSD;
          totalRetirementUSD += m.projectedRetirementTotalUSD;
          sumProgress += m.progressPct;
        }

        const avgProgress = appState.goals.length > 0 ? (sumProgress / appState.goals.length) : 0;
        const totalPnlUSD = totalDcaValueUSD - totalInvestedUSD;
        const totalPnlPct = totalInvestedUSD > 0 ? (totalPnlUSD / totalInvestedUSD) * 100 : 0;

        const elVal = document.getElementById('kpi-total-value');
        if (elVal) elVal.innerHTML = renderDualMoneyHTML(totalPortfolioUSD, 2, null, 'text-xs font-mono font-normal text-slate-400 mt-1');
        const elSub = document.getElementById('kpi-total-sub');
        if (elSub) elSub.textContent = `${appState.goals.length} ativo(s) em acumulação`;

        const elInv = document.getElementById('kpi-total-invested');
        if (elInv) elInv.innerHTML = renderDualMoneyHTML(totalInvestedUSD, 2, totalInvestedBRL, 'text-xs font-mono font-normal text-slate-400 mt-1');
        const elRem = document.getElementById('kpi-remaining-cost');
        if (elRem) elRem.textContent = `Falta investir (hoje): ${formatMoney(totalRemainingUSD, 2)}`;

        const elPnl = document.getElementById('kpi-pnl-value');
        const elPnlPct = document.getElementById('kpi-pnl-pct');
        if (elPnl && elPnlPct) {
          const sign = totalPnlUSD >= 0 ? '+' : '';
          elPnl.innerHTML = appState.currency === 'HYBRID'
            ? `<div>${sign}${formatUSDT(totalPnlUSD, 2)}</div><div class="text-xs font-mono font-normal text-slate-400 mt-1">≈ ${sign}${formatBRL(totalPnlUSD * getEffectiveUsdtBrlRate(), 2)}</div>`
            : `${sign}${formatMoney(totalPnlUSD, 2)}`;
          elPnl.className = `text-2xl sm:text-3xl font-extrabold tabular-nums tracking-tight ${totalPnlUSD >= 0 ? 'text-emerald-400' : 'text-rose-400'}`;
          elPnlPct.textContent = totalInvestedUSD > 0
            ? `${sign}${totalPnlPct.toFixed(2).replace('.', ',')}% sobre o capital aportado`
            : 'Registre compras mensais para calcular lucro/prejuízo';
        }

        const elRet = document.getElementById('kpi-retirement-projected');
        if (elRet) elRet.innerHTML = renderDualMoneyHTML(totalRetirementUSD, 2, null, 'text-xs font-mono font-normal text-amber-200/70 mt-1');
        const elProgTxt = document.getElementById('kpi-overall-progress-text');
        if (elProgTxt) elProgTxt.textContent = `${avgProgress.toFixed(1).replace('.', ',')}%`;
        const elProgBar = document.getElementById('kpi-overall-progress-bar');
        if (elProgBar) elProgBar.style.width = `${avgProgress}%`;

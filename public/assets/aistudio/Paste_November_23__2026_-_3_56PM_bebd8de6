      window.exportJSON = function () {
        try {
          const dataStr = JSON.stringify(appState, null, 2);
          const blob = new Blob([dataStr], { type: 'application/json' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `rg_crypto_dca_backup_${new Date().toISOString().slice(0, 10)}.json`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
          showToast('Backup JSON exportado!', 'success');
        } catch (err) {
          showToast('Não foi possível baixar o arquivo neste navegador.', 'error');
        }
      };

      window.importJSON = function (event) {
        const file = event.target && event.target.files && event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (e) => {
          try {
            const parsed = JSON.parse(e.target.result);
            if (parsed && Array.isArray(parsed.goals)) {
              SafeStorage.setItem(STORAGE_KEY, JSON.stringify(parsed));
              loadState();
              window.setCurrency(appState.currency);
              showToast('Backup importado com sucesso!', 'success');
            } else {
              showToast('Arquivo JSON inválido.', 'error');
            }
          } catch (err) {
            showToast('Erro ao processar arquivo JSON.', 'error');
          }
        };
        reader.readAsText(file);
      };

      window.exportCSV = function () {
        try {
          const rows = [
            ['Cripto', 'Simbolo', 'Mes', 'Data', 'Meta_Mensal', 'Comprado', 'Preco_Pago_USDT', 'Cambio_BRL_USDT', 'Investido_USDT', 'Investido_BRL', 'Preco_Medio_USDT', 'Saldo_Acumulado']
          ];
          for (const g of appState.goals) {
            const m = calculateGoalMetrics(g);
            for (const s of m.schedule) {
              rows.push([
                g.name,
                g.symbol,
                s.month,
                s.label,
                s.plannedQty.toFixed(4),
                s.boughtQty.toFixed(4),
                s.pricePaidUSD.toFixed(4),
                s.fxRateBRL.toFixed(4),
                s.monthCostUSD.toFixed(2),
                s.monthCostBRL.toFixed(2),
                s.cumAvgPriceUSD.toFixed(4),
                s.cumCoins.toFixed(4)
              ]);
            }
          }
          const csvContent = '\uFEFF' + rows.map(r => r.join(';')).join('\n');
          const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `rg_crypto_dca_planilha_${new Date().toISOString().slice(0, 10)}.csv`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
          showToast('Planilha CSV exportada!', 'success');
        } catch (err) {
          showToast('Erro ao exportar planilha CSV.', 'error');
        }
      };

      function showToast(message, type = 'info') {
        const container = document.getElementById('toast-container');
        if (!container) return;
        const toast = document.createElement('div');
        const colors = {
          success: 'bg-emerald-950/95 border-emerald-500/50 text-emerald-200',
          error: 'bg-rose-950/95 border-rose-500/50 text-rose-200',
          info: 'bg-slate-900/95 border-slate-700 text-slate-200'
        };
        toast.className = `px-4 py-3 rounded-xl border shadow-2xl text-xs font-semibold backdrop-blur-md transition-all duration-300 ${colors[type] || colors.info}`;
        toast.textContent = message;
        container.appendChild(toast);

        setTimeout(() => {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(8px)';
          setTimeout(() => toast.remove(), 300);
        }, 3200);
      }

      document.addEventListener('click', (e) => {
        const dropdown = document.getElementById('data-dropdown');
        if (dropdown && !dropdown.classList.contains('hidden')) {
          if (!e.target.closest('#data-dropdown') && !e.target.closest('#btn-data-menu')) {
            dropdown.classList.add('hidden');
          }
        }
      });

      // =====================================================================
      // 15. INICIALIZAÇÃO IMEDIATA E SEGURA
      // =====================================================================
      function initApp() {
        loadState();
        updateApiStatusUI();
        window.setCurrency(appState.currency);
        window.fetchAllPrices(false);

        setInterval(() => {
          window.fetchAllPrices(false);
        }, 12000);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initApp);
      } else {
        initApp();
      }
    })();
  </script>
</body>

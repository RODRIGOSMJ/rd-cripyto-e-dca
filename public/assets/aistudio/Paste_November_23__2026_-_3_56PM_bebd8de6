                  success = true;
                }
              }
              if (success) appState.priceSource = 'CoinGecko';
            }
          } catch (_) {
            // Mantém preços locais de referência sem erro
          }
        }

        if (success) {
          appState.isLiveConnected = true;
          appState.lastPriceUpdate = new Date();
          saveState();
          if (manualTrigger) {
            showToast(`Cotações sincronizadas via ${appState.priceSource}!`, 'success');
